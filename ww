// In-memory data store for the application instance
class AuthStore {
  private users = new Map<string, StoredUser>();
  private watchHistory = new Map<string, WatchHistoryItem[]>(); // userId -> items
  private favourites = new Map<string, FavouriteItem[]>(); // userId -> items

  constructor() {
    // Seed standard demo user
    this.createUser('demo@munowatch.com', 'Demo User', 'password123', 'vip');
    this.createUser('free@munowatch.com', 'Guest Member', 'password123', 'free');
  }

  hashPassword(password: string): string {
    const salt = 'munowatch_salt_seed';
    return crypto.scryptSync(password, salt, 32).toString('hex');
  }

  createUser(email: string, name: string, passwordPlain: string, tier: SubscriptionTier = 'free'): StoredUser {
    const id = 'usr_' + crypto.randomUUID().slice(0, 8);
    const storedUser: StoredUser = {
      id,
      email: email.toLowerCase().trim(),
      name: name.trim(),
      passwordHash: this.hashPassword(passwordPlain),
      tier,
      createdAt: new Date().toISOString(),
      isEmailVerified: true,
      avatarUrl: `https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(name)}`
    };

    this.users.set(storedUser.id, storedUser);
    return storedUser;
  }

  findByEmail(email: string): StoredUser | null {
    const target = email.toLowerCase().trim();
    for (const user of this.users.values()) {
      if (user.email === target) return user;
    }
    return null;
  }

  findById(id: string): StoredUser | null {
    return this.users.get(id) || null;
  }

  verifyPassword(user: StoredUser, passwordPlain: string): boolean {
    return user.passwordHash === this.hashPassword(passwordPlain);
  }

  generateToken(user: StoredUser): string {
    const payload = {
      uid: user.id,
      email: user.email,
      tier: user.tier,
      exp: Date.now() + 7 * 24 * 60 * 60 * 1000 // 7 days
    };
    const encodedPayload = Buffer.from(JSON.stringify(payload)).toString('base64url');
    const signature = crypto.createHmac('sha256', JWT_SECRET).update(encodedPayload).digest('base64url');
    return `${encodedPayload}.${signature}`;
  }

  verifyToken(token: string): StoredUser | null {
    if (!token) return null;
    try {
      const [encodedPayload, signature] = token.split('.');
      if (!encodedPayload || !signature) return null;

      const expectedSig = crypto.createHmac('sha256', JWT_SECRET).update(encodedPayload).digest('base64url');
      if (expectedSig !== signature) return null;

      const payload = JSON.parse(Buffer.from(encodedPayload, 'base64url').toString('utf8'));
      if (Date.now() > payload.exp) return null;

      return this.findById(payload.uid);
    } catch {
      return null;
    }
  }

  updateSubscription(userId: string, tier: SubscriptionTier): StoredUser | null {
    const user = this.users.get(userId);
    if (!user) return null;
    user.tier = tier;
    this.users.set(userId, user);
    return user;
  }

  toPublicProfile(user: StoredUser): UserProfile {
    return {
      id: user.id,
      email: user.email,
      name: user.name,
      tier: user.tier,
      createdAt: user.createdAt,
      isEmailVerified: user.isEmailVerified,
      avatarUrl: user.avatarUrl
    };
  }

  // Watch History
  getWatchHistory(userId: string): WatchHistoryItem[] {
    return this.watchHistory.get(userId) || [];
  }

  saveWatchHistory(userId: string, item: Omit<WatchHistoryItem, 'id' | 'userId' | 'updatedAt'>): WatchHistoryItem {
    const list = this.watchHistory.get(userId) || [];
    const existingIndex = list.findIndex(h => h.itemId === item.itemId && h.episodeNumber === item.episodeNumber);

    const updatedItem: WatchHistoryItem = {
      ...item,
      id: 'wh_' + crypto.randomUUID().slice(0, 8),
      userId,
      updatedAt: new Date().toISOString()
    };

    if (existingIndex >= 0) {
      list[existingIndex] = updatedItem;
    } else {
      list.unshift(updatedItem);
    }

    // Keep up to 20 recent items
    const trimmed = list.slice(0, 20);
    this.watchHistory.set(userId, trimmed);
    return updatedItem;
  }

  // Favourites
  getFavourites(userId: string): FavouriteItem[] {
    return this.favourites.get(userId) || [];
  }

  addFavourite(userId: string, item: Omit<FavouriteItem, 'id' | 'userId' | 'addedAt'>): FavouriteItem {
    const list = this.favourites.get(userId) || [];
    const exists = list.find(f => f.itemId === item.itemId);
    if (exists) return exists;

    const newFav: FavouriteItem = {
      ...item,
      id: 'fav_' + crypto.randomUUID().slice(0, 8),
      userId,
      addedAt: new Date().toISOString()
    };

    list.unshift(newFav);
    this.favourites.set(userId, list);
    return newFav;
  }

  removeFavourite(userId: string, itemId: string): boolean {
    const list = this.favourites.get(userId) || [];
    const filtered = list.filter(f => f.itemId !== itemId);
    this.favourites.set(userId, filtered);
    return filtered.length < list.length;
  }
}

export const authStore = new AuthStore();
